{
    "name": "mathiasreker/php-svg-optimizer",
    "description": "php-svg-optimizer is a PHP library designed to optimize SVG files by applying various transformations and cleanup operations.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "optimize",
        "svg",
        "minify",
        "compress",
        "clean",
        "sanitize",
        "sanitizer",
        "optimizer",
        "xss",
        "cli"
    ],
    "authors": [
        {
            "name": "Mathias Reker",
            "role": "Senior Developer"
        }
    ],
    "homepage": "https://github.com/MathiasReker/php-svg-optimizer",
    "support": {
        "issues": "https://github.com/MathiasReker/php-svg-optimizer/issues",
        "source": "https://github.com/MathiasReker/php-svg-optimizer",
        "security": "https://github.com/MathiasReker/php-svg-optimizer/security/policy"
    },
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "brainbits/phpstan-rules": "^4.0",
        "ergebnis/composer-normalize": "^2.54",
        "ergebnis/phpstan-rules": "^2.14",
        "friendsofphp/php-cs-fixer": "^3.95",
        "hiperdk/phpstan-rules": "^1.0",
        "infection/infection": "^0.35",
        "kubawerlos/php-cs-fixer-custom-fixers": "^3.37",
        "odan/phpstan-rules": "^0.2",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "^2.7",
        "shipmonk/phpstan-rules": "^4.4",
        "spaze/phpstan-disallowed-calls": "^4.14",
        "symplify/phpstan-rules": "^14.18",
        "tomasvotruba/cognitive-complexity": "^1.3",
        "tomasvotruba/type-coverage": "^2.5",
        "voku/phpstan-rules": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "MathiasReker\\PhpSvgOptimizer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MathiasReker\\PhpSvgOptimizer\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "vendor/marc-mabe/php-enum/stubs/"
        ]
    },
    "bin": [
        "bin/svg-optimizer"
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.3"
        },
        "preferred-install": "dist",
        "process-timeout": 1800,
        "sort-packages": true
    },
    "scripts": {
        "analyze:all": [
            "@analyze:validate",
            "@analyze:normalize",
            "@analyze:phpstan",
            "@analyze:rector",
            "@analyze:php-cs-fixer",
            "@analyze:audit"
        ],
        "analyze:audit": "composer audit --format=table",
        "analyze:autoload": "composer dump-autoload -o --strict-psr --strict-ambiguous",
        "analyze:check": "composer check",
        "analyze:normalize": "composer normalize --dry-run --no-check-lock",
        "analyze:php-cs-fixer": "bash -c 'unset PHP_BINARY; $(command -v php8.3 || command -v php) vendor/bin/php-cs-fixer fix . --config=.php-cs-fixer.dist.php --dry-run --diff'",
        "analyze:phpstan": "@php vendor/bin/phpstan analyse -c phpstan.neon",
        "analyze:rector": "@php vendor/bin/rector process --dry-run",
        "analyze:validate": "composer validate --strict",
        "build:badges": "bash dev/scripts/badges.sh",
        "build:badges-fast": "bash dev/scripts/badges.sh --skip-mutation",
        "lint:all": [
            "@lint:normalize",
            "bash -c 'composer lint:rector; composer lint:php-cs-fixer'"
        ],
        "lint:normalize": "composer normalize",
        "lint:php-cs-fixer": "bash -c 'unset PHP_BINARY; $(command -v php8.3 || command -v php) vendor/bin/php-cs-fixer fix . --config=.php-cs-fixer.dist.php'",
        "lint:rector": "@php vendor/bin/rector process",
        "test": "@php vendor/bin/phpunit tests",
        "test:benchmark": "@php dev/scripts/benchmark.php",
        "test:coverage": "@php vendor/bin/phpunit tests --coverage-text",
        "test:mutation": "@php vendor/bin/infection --threads=max"
    }
}
