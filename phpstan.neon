parameters:
  level: max
  paths:
    - bin/svg-optimizer
    - src
    - tests
  excludePaths:
    - vendor
  parallel:
    maximumNumberOfProcesses: 4
    processTimeout: 900.0
  customRulesetUsed: true
  fileExtensions:
    - php
  exceptions:
    check:
      missingCheckedExceptionInThrows: true
      tooWideThrowType: true
    implicitThrows: false
    uncheckedExceptionClasses:
      - DOMException
  ignoreErrors:
    - identifier: symplify.forbiddenTrait
    - identifier: symplify.requiredInterfaceContractNamespace
    - identifier: ergebnis.noNullableReturnTypeDeclaration
      path: src/Rule.php
    - identifier: symplify.requireExceptionNamespace
      path: src/Xml/ParseException.php
  type_coverage:
    return: 100
    param: 100
    property: 100
    constant: 100
  ergebnis:
    noExtends:
      classesAllowedToBeExtended:
        - RuntimeException
        - LogicException
        - InvalidArgumentException
        - Exception
        - MathiasReker\PhpSvgOptimizer\Console\Output\Stream\AbstractStream
includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/odan/phpstan-rules/rules.neon
