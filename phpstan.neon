parameters:
  level: max
  checkMissingOverrideMethodAttribute: true
  paths:
    - bin/svg-optimizer
    - src
    - tests
  excludePaths:
    - vendor
    - tests/Architecture/Rule/Fixture
  parallel:
    maximumNumberOfProcesses: 4
    processTimeout: 900.0
  customRulesetUsed: true
  fileExtensions:
    - php
  exceptions:
    check:
      missingCheckedExceptionInThrows: true
      tooWideThrowType: true
    implicitThrows: false
    uncheckedExceptionClasses:
      - DOMException
  ignoreErrors:
    - identifier: symplify.forbiddenTrait
    - identifier: symplify.requiredInterfaceContractNamespace
    - identifier: ergebnis.noNullableReturnTypeDeclaration
      path: src/Rule.php
    - identifier: symplify.requireExceptionNamespace
      path: src/Xml/ParseException.php
    - identifier: ergebnis.final
      path: src/Exception/IOException.php
    - identifier: symplify.explicitAbstractPrefixName
      path: tests/Unit/Console/Output/AbstractStreamTest.php
    - message: '#^No @covers or \#\[CoversClass\] found in test\.$#'
      path: tests/Unit/*TraitTest.php
    - identifier: ergebnis.noExtends
      path: src/Exception/FileNotFoundException.php
    - identifier: symplify.forbiddenExtendOfNonAbstractClass
      path: src/Exception/FileNotFoundException.php
  type_coverage:
    return: 100
    param: 100
    property: 100
    constant: 100
  ergebnis:
    noExtends:
      classesAllowedToBeExtended:
        - RuntimeException
        - LogicException
        - InvalidArgumentException
        - Exception
        - MathiasReker\PhpSvgOptimizer\Console\Output\AbstractStream
        - PHPStan\Testing\RuleTestCase
  phpat:
    ignore_built_in_classes: true
    show_rule_names: true
services:
  - class: MathiasReker\PhpSvgOptimizer\Tests\Architecture\LayerTest
    tags:
      - phpat.test
  - class: MathiasReker\PhpSvgOptimizer\Tests\Architecture\DeclarationTest
    tags:
      - phpat.test
rules:
  - MathiasReker\PhpSvgOptimizer\Tests\Architecture\Rule\NoDomInPublicApiRule
  - MathiasReker\PhpSvgOptimizer\Tests\Architecture\Rule\NoStaticPropertyRule
  - MathiasReker\PhpSvgOptimizer\Tests\Architecture\Rule\TraitSuffixRule
  - MathiasReker\PhpSvgOptimizer\Tests\Architecture\Rule\VisibilityTagRule
includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/odan/phpstan-rules/rules.neon
