#!/usr/bin/env php
<?php

/**
 *     This file is part of the php-svg-optimizer package.
 *     (c) Mathias Reker <github@reker.dk>
 *     For the full copyright and license information, please view the LICENSE
 *     file that was distributed with this source code.
 */

declare(strict_types=1);

namespace MathiasReker\PhpSvgOptimizer;

use MathiasReker\PhpSvgOptimizer\Console\Command\CommandDispatcher;

if (\function_exists('ini_set')) {
    ini_set('memory_limit', '-1');
}

if (\function_exists('error_reporting')) {
    error_reporting(\E_ALL);
}

$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',
    \is_string($GLOBALS['_composer_autoload_path'] ?? null) ? $GLOBALS['_composer_autoload_path'] : '',
    __DIR__ . '/../../../../vendor/autoload.php',
];

$autoloadLoaded = false;
foreach ($autoloadCandidates as $autoloadCandidate) {
    $real = realpath($autoloadCandidate);
    if (false !== $real && is_file($real)) {
        include_once $real;
        $autoloadLoaded = true;
        break;
    }
}

if (\PHP_SAPI !== 'cli') {
    echo 'This command can only be run in a CLI environment.', \PHP_EOL;

    exit(1);
}

if (!$autoloadLoaded) {
    fwrite(\STDERR, 'Unable to find the Composer autoloader. Run "composer install" first.' . \PHP_EOL);

    exit(1);
}

exit(CommandDispatcher::fromArgs($argv)->run());
